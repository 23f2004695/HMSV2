# Copy to .env and fill in. Everything here is optional for local development.

SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Default admin account created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@hospital.com

# Redis for caching + Celery (the app falls back to an in-memory cache if Redis isn't running)
REDIS_URL=redis://localhost:6379
# CACHE_TYPE=SimpleCache

# Database (defaults to hospital.db in the project folder)
# DATABASE_URL=sqlite:///hospital.db

# Email for reminders and monthly reports (Gmail needs an app password)
MAIL_USERNAME=
MAIL_PASSWORD=
